{
  "name": "@typekit-i18n/playground-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist generated",
    "dev": "vite",
    "pregen": "pnpm --filter @number10/typekit-i18n run build",
    "gen": "node ../../packages/typekit-i18n/dist/cli.js generate --config ./typekit.config.ts",
    "gen:intern": "typekit-i18n",
    "lint:i18n": "node ../../packages/typekit-i18n/dist/cli.js lint --config ./typekit.config.ts --source 'src/**/*.tsx'",
    "build": "pnpm run gen && vite build",
    "build:analyze": "pnpm run gen && vite build --mode analyze",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@number10/typekit-i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
