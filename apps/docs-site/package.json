{
  "name": "@typekit-i18n/docs-site",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf docs/.vitepress/dist",
    "docs:sync-playground": "pnpm --filter @typekit-i18n/playground-ts run gen",
    "docs:dev": "pnpm run docs:sync-playground && vitepress dev docs --port 4174",
    "gen": "echo \"No code generation defined for docs-site\"",
    "build": "pnpm run docs:build",
    "docs:build": "pnpm run docs:sync-playground && vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4175",
    "check-seo": "node /Volumes/MR-SX5/projects/check-seo.mjs ./docs/.vitepress/dist --base-url https://typekit-i18n.number10.de",
    "lint": "eslint --no-error-on-unmatched-pattern \"docs/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@number10/typekit-i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "mermaid": "^11.15.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.38"
  }
}
