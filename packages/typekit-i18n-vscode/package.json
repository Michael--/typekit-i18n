{
  "name": "typekit-i18n-vscode",
  "displayName": "typekit-i18n",
  "description": "VS Code extension for typekit-i18n — inline key suggestions, diagnostics, hover previews, and translation workflow support for TypeScript/JavaScript projects",
  "version": "0.2.1",
  "publisher": "number10",
  "homepage": "https://typekit-i18n.number10.de/vscode-extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/Michael--/typekit-i18n.git",
    "directory": "packages/typekit-i18n-vscode"
  },
  "bugs": {
    "url": "https://github.com/Michael--/typekit-i18n/issues",
    "email": "mr@number10.de"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "vscode-extension",
    "typekit-i18n",
    "diagnostics",
    "completion",
    "hover",
    "intellisense",
    "typescript",
    "javascript"
  ],
  "type": "module",
  "files": [
    "dist/extension.cjs",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/DIAGNOSTICS.md"
  ],
  "icon": "media/typekit-i18n.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:yaml",
    "onLanguage:csv"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "typekitI18n.refreshIndex",
        "title": "typekit-i18n: Refresh Translation Index"
      },
      {
        "command": "typekitI18n.runDiagnostics",
        "title": "typekit-i18n: Run Diagnostics"
      },
      {
        "command": "typekitI18n.measureIndexPerformance",
        "title": "typekit-i18n: Measure Index Performance"
      }
    ],
    "configuration": {
      "title": "typekit-i18n",
      "properties": {
        "typekitI18n.translationGlobs": {
          "type": "array",
          "description": "Workspace globs used to discover translation source files.",
          "default": [
            "**/translations/**/*.{yaml,yml,csv}"
          ],
          "items": {
            "type": "string"
          }
        },
        "typekitI18n.completionMode": {
          "type": "string",
          "enum": [
            "fallback",
            "always",
            "alwaysPreferExtension"
          ],
          "default": "alwaysPreferExtension",
          "description": "Completion strategy. 'fallback' disables extension key completion in TypeScript/TSX to avoid duplicates with typed key suggestions. 'alwaysPreferExtension' keeps extension completions active and prioritizes them."
        },
        "typekitI18n.previewLocales": {
          "type": "array",
          "description": "Locales shown in completion details and hover preview. Empty uses a default locale preview.",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "typekitI18n.previewMaxLocales": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "Maximum number of locales shown in completion details and hover preview."
        },
        "typekitI18n.enablePlaceholderSnippets": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, completion inserts placeholder object snippets for parameterized translation keys if no argument object exists yet."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "package:local": "pnpm run build && vsce package --allow-missing-repository --no-dependencies --allow-package-all-secrets --allow-package-env-file",
    "package:release": "pnpm run build && pnpm dlx @vscode/vsce package --allow-missing-repository --no-dependencies",
    "package:vsix": "pnpm run package:local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
