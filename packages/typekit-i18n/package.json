{
  "name": "@number10/typekit-i18n",
  "version": "0.3.1",
  "description": "Type-safe internationalization toolkit for TypeScript — runtime APIs, ICU message rendering, and code generation from CSV/YAML resources",
  "private": false,
  "license": "MIT",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "translation",
    "icu",
    "icu-message",
    "icu-messageformat",
    "typescript",
    "codegen",
    "csv",
    "yaml",
    "type-safe",
    "typekit",
    "typekit-i18n",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael--/typekit-i18n.git",
    "directory": "packages/typekit-i18n"
  },
  "homepage": "https://michael--.github.io/typekit-i18n/",
  "bugs": {
    "url": "https://github.com/Michael--/typekit-i18n/issues",
    "email": "mr@number10.de"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/*.js",
    "dist/src",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "typekit-i18n": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "import": "./dist/runtime.js"
    },
    "./runtime/basic": {
      "types": "./dist/src/runtime/basic.d.ts",
      "import": "./dist/runtime-basic.js"
    },
    "./runtime/icu": {
      "types": "./dist/src/runtime/icu.d.ts",
      "import": "./dist/runtime-icu.js"
    },
    "./runtime/icu-formatjs": {
      "types": "./dist/src/runtime/icuFormatjs.d.ts",
      "import": "./dist/runtime-icu-formatjs.js"
    },
    "./codegen": {
      "types": "./dist/src/codegen/index.d.ts",
      "import": "./dist/codegen.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist generated",
    "build:cli": "vite build --config vite.cli.config.ts",
    "gen": "node --import tsx src/codegen/cli.ts generate",
    "validate:yaml-example": "node --import tsx src/codegen/cli.ts validate --input resources/translations/translationTableExample.yaml --format yaml",
    "prebuild": "pnpm run gen",
    "build": "vite build && pnpm run build:cli && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "fast-csv": "^5.0.7",
    "glob": "^13.0.6",
    "picocolors": "^1.1.1",
    "tsx": "^4.22.4",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "intl-messageformat": "^11.1.2"
  },
  "peerDependenciesMeta": {
    "intl-messageformat": {
      "optional": true
    }
  },
  "devDependencies": {
    "intl-messageformat": "^11.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
